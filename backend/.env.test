# ──────────────────────────────────────────────────────────────────────────────
# TEST ENVIRONMENT — loaded automatically by jest.config.js
#
# Point DATABASE_URL at a dedicated test database, NOT the production one.
# Options:
#   A) Separate Supabase project (free tier at supabase.com)
#   B) Local PostgreSQL:  postgresql://postgres:postgres@localhost:5432/ai_spend_tracker_test
#
# IMPORTANT: keep TEST_SAFE=true here. The testSafetyGuard checks for it and
# will refuse to run (and delete data) if it's missing.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
TEST_SAFE=true

# Replace with your dedicated test database URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_spend_tracker_test

JWT_SECRET=test-secret-not-for-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

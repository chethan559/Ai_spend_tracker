generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  apiKey               String        @unique
  plan                 String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  password             String
  logs                 ApiLog[]
  budgets              Budget[]
  budgetAlerts         BudgetAlert[]
  projects             Project[]
}

model ApiLog {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  model        String
  cost         Float
  metadata     Json?
  projectId    String?
  timestamp    DateTime
  createdAt    DateTime @default(now())
  inputTokens  Int
  outputTokens Int
  latencyMs    Int?
  project      Project? @relation(fields: [projectId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([userId, timestamp(sort: Desc)], map: "ApiLog_userId_timestamp_desc_idx")
  @@index([userId, provider])
  @@index([userId, provider, timestamp])
  @@index([userId, projectId, timestamp])
  @@index([timestamp])
  @@index([metadata], type: Gin)
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  apiKey      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  logs        ApiLog[]
  budget      Budget?
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, name])
  @@index([userId])
  @@index([apiKey])
}

model Budget {
  id              String        @id @default(uuid())
  userId          String
  projectId       String?       @unique
  amount          Float
  period          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  alertThreshold  Int?
  alertChannel    String?
  slackWebhookUrl String?
  project         Project?      @relation(fields: [projectId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  alerts          BudgetAlert[]

  @@index([userId])
  @@index([projectId])
}

model BudgetAlert {
  id        String   @id @default(uuid())
  budgetId  String
  userId    String
  threshold Int
  channel   String
  sentAt    DateTime @default(now())
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([budgetId])
  @@index([userId])
}

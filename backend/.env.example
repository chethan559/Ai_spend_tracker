# Runtime environment (development, production, test).
NODE_ENV=development

# Port for the API server.
PORT=3001

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/aispendtracker

# JWT secret used to sign and verify tokens.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT expiration window (e.g. 7d, 1h).
JWT_EXPIRES_IN=7d

# CORS — set this to your production frontend URL.
# e.g. https://aispendtracker.com
FRONTEND_URL=http://localhost:3000

# Optional — comma-separated list of extra allowed origins.
# e.g. https://app.yourdomain.com,https://admin.yourdomain.com
EXTRA_ALLOWED_ORIGINS=

# Resend email delivery (https://resend.com — free tier: 3,000 emails/month).
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=AI Spend Tracker <alerts@yourdomain.com>

# Email address used for /test-email endpoint during development.
TEST_EMAIL=you@example.com
